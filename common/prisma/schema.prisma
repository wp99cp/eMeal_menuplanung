datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  output          = env("PRISMA_OUTPUT")
  previewFeatures = ["fullTextSearch", "metrics", "tracing", "views"]
}

// ##############################
// ##############################
// ## Data model
// ##############################
// ##############################

//
// *Naming conventions*
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference
//
// Model:
//  - names must start with a letter and are typically spelled in PascalCase
//  - names should use the singular form (for example, User instead of user, users or Users)
//  - names should be singular and not plural (for example, User instead of Users)
//
// Field:
// - names must start with a letter and are typically spelled in camelCase
//

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  password          String?
  emailVerified     Boolean? @default(false)
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  created_at        Int?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Represents a user account
model User {
  id String @id @default(cuid())

  // base data of the user
  name     String?
  email    String? @unique
  username String? @unique @default(cuid())

  // if set to true, the email address will be publically visible
  shareEmail Boolean @default(false)

  // if the user is hidden, he will not be visible in the user list
  // you can only share a camp with that user by entering the email address
  isHiddenUser Boolean @default(false)

  emailVerified DateTime? /// date of the last email verification, null if not verified

  // indecation if the user has used the previous version of the app
  // if set to true, the user may be allowed to transfer data from the old version
  usedOldVersion Boolean @default(false)

  image    String?
  accounts Account[]
  sessions Session[]

  // registration meta data
  newUser      Boolean  @default(true) /// new users may have not finished the onboarding process
  registeredAt DateTime @default(now()) /// the date and time of account creation
  meals        Meal[]

  // a list of camps the user has access to (excluding the ones he owns)
  campAccess CampAccessRight[] @relation(name: "access")
  gaveAccess CampAccessRight[] @relation(name: "gaveAccess")

  camps Camp[] @relation(name: "campOwnership")
}

model ParticipantCount {
  // could be a campId, mealId, dayId, ...
  id String @id @default(cuid())

  lastModification DateTime @updatedAt /// the date and time of the last modification

  // number of participants
  participantCount Int @default(0) /// the number of participants (including vegetarians and vegans)
  vegetarianCount  Int @default(0) /// the number of vegetarians
  veganCount       Int @default(0) /// the number of vegans

  /// if true, the count is relative to the total number of participants of the parent object
  isRelative Boolean @default(false)

  /// will not be updated if true
  isFixed Boolean @default(false)

  camp Camp?
  day  Day?
  meal Meal?
}

enum CampAccessRightLevel {
  /// the owner has all rights to the camp, can edit all MealUsages
  /// editing the meal usages does not mean, that the user can edit the meals or recipes itselfs
  /// but only the usage of the meal in the camp
  OWNER

  /// the manager can edit the camp and the camp access rights, can edit all MealUsages
  MANAGER

  /// the editor can edit the camp, can edit all MealUsages
  EDITOR

  /// the viewer can only view the camp, can view all MealUsages
  VIEWER
}

// the access rights to a camp
model CampAccessRight {
  id String @id @default(cuid())

  creationDate     DateTime @default(now()) /// the date and time of the creation
  lastModification DateTime @updatedAt /// the date and time of the last modification

  // the user who has the right
  userId String /// the id of the user
  user   User   @relation(name: "access", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // the user who gave the right
  hasGivenUserId String? /// the id of the user who gave the right; null if the user is the owner
  hasGivenUser   User?   @relation(name: "gaveAccess", fields: [hasGivenUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // the camp to which the right belongs
  campId String /// the id of the camp
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // the level of the right
  level   CampAccessRightLevel @default(VIEWER)
  isOwner Boolean? // null if the user is not the owner, true if the user is the owner

  @@unique([userId, campId], name: "uniqueUserCampAccessLevel")
  @@unique([campId, isOwner], name: "uniqueCampOwner")
  // the index is used to search for the access rights of a user
  @@index([userId], name: "userIndex")
  @@index([campId], name: "campIndex")
  @@index([userId, campId], name: "campAccessIndex")
}

/// This is the main data model of the app.
model Camp {
  id String @id @default(cuid())

  // an archived camp cannot be edited by any usser
  // only the owner can archive a camp or unarchive it
  // the camp will be automatically archived if the owner deletes his account
  // the camp will be automatically archived one month after the last camp day
  is_archived Boolean @default(false)

  name        String /// the name of the camp
  description String? /// the description of the camp
  year        Int /// the year of the camp

  creationDate DateTime @default(now())

  // the modification date is updated whenever the camp is modified
  // or a child object is modified (e.g. a day, meal, ...)
  lastModification DateTime @updatedAt

  // each camp has exactly one participant count
  participantCountId String           @unique /// the id of the participant count @unique
  participantCount   ParticipantCount @relation(fields: [participantCountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // each camp has a list of days and a list of meal usages
  days  Day[]
  meals Meal[]

  // each camp has one owner, the owner is the user who created the camp
  // the owner has all rights to the camp, if the owner is deleted, the camp will be archived
  // any editor can be promoted to owner and unarchive the camp
  ownerUserId String?
  owner       User?   @relation(name: "campOwnership", fields: [ownerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  campExports CampExport[]

  // each camp has a list of users who have access to the camp
  // this list includes the owner (access is granted based on that list)
  userAccess CampAccessRight[]

  // index for camp search
  @@index([year], name: "yearIndex")
}

model Day {
  id String @id @default(cuid())

  date        DateTime @db.Date /// the date of the day
  description String? /// the description of the day

  creationDate     DateTime @default(now())
  lastModification DateTime @updatedAt

  // each day belongs to exactly one camp
  campId String /// the id of the camp
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  meals  Meal[]

  // each camp has exactly one participant count
  participantCountId String?           @unique /// the id of the participant count @unique
  participantCount   ParticipantCount? @relation(fields: [participantCountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // days may be associated with shopping lists
  dayToShoppingList ShoppingListToDay[]

  // the tuple day and campId is unique
  @@unique([campId, date])
}

// How does the meal access work
// - each template has exactly one owner, the owner can edit the meal (and all associated recipes and ingredients).
// - everytime the meal is used in a camp, a new copy is created, the template meal is linked as the original meal
// - this meal usage is shared accoring to the access rights of the camp
// - the owner can merge the meal usages back to the template meal, a warning if any of the meal usages has been modified
// ask for confirmation to merge the meals back to the template meal
// TODO: use https://www.prisma.io/docs/orm/prisma-schema/data-model/table-inheritance
//   to separate the template meal from the meal usage
model Meal {
  id String @id @default(cuid())

  name        String
  description String?
  keywords    String[]

  creationDate     DateTime @default(now())
  lastModification DateTime @updatedAt

  // each meal has max one owner
  // we only set ownerId if the meal is a template, but not if it is a concrete meal usage
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // each meal has a list of recipes
  recipes Recipe[]

  // each meal is either a template or a concrete meal usage
  isTemplate   Boolean @default(true) /// if true, the meal is a template and cannot be used in a camp
  templateId   String? /// the id of the original meal
  templateMeal Meal?   @relation(name: "originalMeal", fields: [templateId], references: [id])
  mealUsages   Meal[]  @relation(name: "originalMeal")

  // indecation if the meal has unmerged derivations
  // this is used to show a warning if the meal is merged back to the template meal
  // false for templates
  hasUnmergedDerivations Boolean @default(false)

  campId String /// the id of the camp
  date   DateTime @db.Date

  // each camp has exactly one participant count
  participantCountId String?           @unique /// the id of the participant count @unique
  participantCount   ParticipantCount? @relation(fields: [participantCountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // each meal can be used in exactly one (camp, day) tuple
  day  Day?  @relation(fields: [campId, date], references: [campId, date], onDelete: Cascade, onUpdate: Cascade)
  camp Camp? @relation(fields: [campId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// each recipe belongs to exactly one meal
// we separate meals from recipes to make them searchable
// recipes have no separate access rights, but are always associated with a meal
/// Represents a recipe
model Recipe {
  id String @id @default(cuid())

  creationDate     DateTime @default(now()) /// the date and time of the creation
  lastModification DateTime @updatedAt /// the date and time of the last modification

  order Int @default(autoincrement()) /// the order of the recipe in the meal

  name        String
  description String?
  keywords    String[]

  /// the ingredients of the recipe
  ingredients Ingredient[]

  // each recipe belongs to exactly one meal
  mealId String /// the id of the meal
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // the tuple order mealId is unique
  @@unique([mealId, order])
}

/// Represents an ingredient of a recipe
model Ingredient {
  id    String @id @default(cuid())
  order Int    @default(autoincrement()) /// the order of the ingredient in the recipe

  creationDate     DateTime @default(now()) /// the date and time of the creation
  lastModification DateTime @updatedAt /// the date and time of the last modification

  // defines the the ingredient
  amount  Decimal?
  unit    String?
  name    String
  isFresh Boolean  @default(false)

  // each ingredient belongs to to exactly one recipe
  recipeId                     String /// the id of the recipe
  recipe                       Recipe                         @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ShoppingListItemToIngredient ShoppingListItemToIngredient[]

  // the index is formed by the tuple of the recipeId and the order
  @@unique([recipeId, order])
}

enum CampExportState {
  PENDING
  IN_PROGRESS
  FAILED
  FINISHED
}

model CampExport {
  id String @id @default(cuid())

  creationDate DateTime @default(now())

  lastStateChange DateTime        @updatedAt /// the export can only be modified by the system not by the user
  state           CampExportState @default(PENDING) /// the state of the export
  progress        Float           @default(0) /// the progress of the export

  campId String
  camp   Camp   @relation(fields: [campId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  campExportSettings Json

  /// ids of the associated files stored in minio
  fileIDs String[]

  shoppingLists ShoppingList[]
}

enum ShoppingListType {
  ONLY_FRESH_INGREDIENTS
  ALL_INGREDIENTS
}

model ShoppingList {
  id String @id @default(cuid())

  creationDate DateTime @default(now()) /// the date and time of the creation
  // we do not store the last modification date, as the item is not modified

  // each shopping list belongs to exactly one camp export
  campExportId String /// the id of the camp export
  campExport   CampExport @relation(fields: [campExportId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // days for which the shopping list contains ingredients (empty list means all days)
  shoppingListToDay ShoppingListToDay[]

  // the type of the shopping list
  type ShoppingListType

  // each shopping list has a list of ingredients
  items ShoppingListItem[]
}

model ShoppingListToDay {
  id String @id @default(cuid())

  creationDate DateTime @default(now()) /// the date and time of the creation
  // we do not store the last modification date, as the item is not modified

  // each shopping list belongs to exactly one camp export
  shoppingListId String /// the id of the shopping list
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // each shopping list belongs to exactly one day
  dayId String /// the id of the day
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ShoppingListCategory {
  id String @id @default(cuid())

  // we do not store any timestamps, as the category is not modified and defined by the system
  name String

  ShoppingListCategoryToShoppingListItem ShoppingListCategoryToShoppingListItem[]

  // super category
  superCategoryId String? /// the id of the super category
  superCategory   ShoppingListCategory?  @relation(name: "categoryHirarchie", fields: [superCategoryId], references: [id])
  subCategories   ShoppingListCategory[] @relation(name: "categoryHirarchie")
}

model ShoppingListCategoryToShoppingListItem {
  id String @id @default(cuid())

  creationDate DateTime @default(now()) /// the date and time of the creation
  // we do not store the last modification date, as the item is not modified

  categoryId String /// the id of the category
  category   ShoppingListCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  shoppingListItemId String /// the id of the shopping list item
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

/// Represents an ingredient of a shopping list
/// a shopping list can be the accumulation of ingredients from multiple meals
/// e.g. the sum of all bananas from all meals
model ShoppingListItem {
  id String @id @default(cuid())

  creationDate DateTime @default(now()) /// the date and time of the creation
  // we do not store the last modification date, as the item is not modified

  // defines the the ingredient
  amount  Float
  unit    String
  name    String
  isFresh Boolean @default(false)

  /// estimated price of the ingredient
  price    Decimal?
  currency String?

  // each ingredient belongs to one or more categories
  categoryIds String[] /// the id of the category

  // references to the original ingredient, this allows to track the origin of the ingredient
  shoppingListItemToIngredients ShoppingListItemToIngredient[]

  // each ingredient belongs to to exactly one shopping list
  shoppingListId                         String /// the id of the shopping list
  ShoppingList                           ShoppingList                             @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ShoppingListCategoryToShoppingListItem ShoppingListCategoryToShoppingListItem[]
}

model ShoppingListItemToIngredient {
  id String @id @default(cuid())

  creationDate DateTime @default(now()) /// the date and time of the creation
  // we do not store the last modification date, as the item is not modified

  // each shopping list item belongs to exactly one ingredient
  shoppingListItemId String /// the id of the shopping list item
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // each shopping list item belongs to exactly one ingredient
  ingredientId String /// the id of the ingredient
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
